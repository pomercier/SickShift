#!/bin/sh
#
### BEGIN INIT INFO
# Provides:          sickshift
# Required-Start:    $local_fs $network $remote_fs
# Required-Stop:     $local_fs $network $remote_fs
# Should-Start:      $NetworkManager
# Should-Stop:       $NetworkManager
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: starts instance of SickShift
# Description:       starts instance of SickShift using start-stop-daemon
### END INIT INFO

# Load the VERBOSE setting and other rcS variables
. /lib/init/vars.sh

# Define LSB log_* functions.
# Depend on lsb-base (>= 3.0-6) to ensure that this file is present.
. /lib/lsb/init-functions

# Source SickShift configuration
if [ -f /etc/default/sickshift ]; then
    . /etc/default/sickshift
else
    [ "${VERBOSE}" != no ] && echo "/etc/default/sickshift not found. Using default settings.";
fi

## Don't set -e
## Don't edit this file!
## Edit user configuration in /etc/default/sickshift to change
##
## SG_USER=         #$RUN_AS, username to run sickshift under, the default is sickshift
## SG_GROUP=        #$RUN_GROUP, group to run sickshift under, the default is sickshift
## SG_HOME=         #$APP_PATH, the location of sickshift.py, the default is /opt/sickshift
## SG_DATA=         #$DATA_DIR, the location of sickbeard.db, cache, logs, the default is /opt/sickshift
## SG_PIDFILE=      #$PID_FILE, the location of sickshift.pid, the default is /var/run/sickshift/sickshift.pid
## PYTHON_BIN=      #$DAEMON, the location of the python binary, the default is /usr/bin/python
## SG_OPTS=         #$EXTRA_DAEMON_OPTS, extra cli option for sickshift, i.e. " --config=/home/sickshift/config.ini"
## SSD_OPTS=        #$EXTRA_SSD_OPTS, extra start-stop-daemon option like " --group=users"
##
## EXAMPLE if want to run as different user
## add SG_USER=username to /etc/default/sickshift
## otherwise default sickshift is used

# Script name
NAME=$(basename "$0")

# App name
DESC=SickShift

## The defaults
# Run as username
RUN_AS=${SG_USER-sickshift}

# Run as group
RUN_GROUP=${SG_GROUP-sickshift}

# Path to app SG_HOME=path_to_app_sickshift.py
APP_PATH=${SG_HOME-/opt/sickshift}

# Data directory where sickbeard.db, cache and logs are stored
DATA_DIR=${SG_DATA-/opt/sickshift}

# Path to store PID file
PID_FILE=${SG_PIDFILE-/var/run/sickshift/sickshift.pid}

# path to python bin
DAEMON=${PYTHON_BIN-/usr/bin/python}

# Extra daemon option like: SG_OPTS=" --config=/home/sickshift/config.ini"
EXTRA_DAEMON_OPTS=${SG_OPTS-}

# Extra start-stop-daemon option like START_OPTS=" --group=users"
EXTRA_SSD_OPTS=${SSD_OPTS-}
##

PID_PATH=$(dirname $PID_FILE)
DAEMON_OPTS=" sickshift.py -q --daemon --nolaunch --pidfile=${PID_FILE} --datadir=${DATA_DIR} ${EXTRA_DAEMON_OPTS}"

##

test -x $DAEMON || exit 0

# Create PID directory if not exist and ensure the SickShift user can write to it
if [ ! -d $PID_PATH ]; then
    mkdir -p $PID_PATH
    chown $RUN_AS $PID_PATH
fi

if [ ! -d $DATA_DIR ]; then
    mkdir -p $DATA_DIR
    chown $RUN_AS $DATA_DIR
fi

if [ -e $PID_FILE ]; then
    PID=`cat $PID_FILE`
    if ! kill -0 $PID > /dev/null 2>&1; then
        [ "$VERBOSE" != no ] && echo "Removing stale $PID_FILE"
        rm -f $PID_FILE
    fi
fi

start_sickshift() {
    [ "$VERBOSE" != no ] && log_daemon_msg "Starting $DESC" "$NAME"
    start-stop-daemon -d $APP_PATH -c $RUN_AS --group=${RUN_GROUP} $EXTRA_SSD_OPTS --start --quiet --pidfile $PID_FILE --exec $DAEMON -- $DAEMON_OPTS
    RETVAL="$?"
    case "${RETVAL}" in
        # Service was started or was running already
        0|1) [ "${VERBOSE}" != no ] && log_end_msg 0 ;;
        # Service couldn't be started
        2) [ "${VERBOSE}" != no ] && log_end_msg 1 ;;
    esac
    [ "${RETVAL}" = 2 ] && return 2
    return 0
}

stop_sickshift() {
    [ "$VERBOSE" != no ] && log_daemon_msg "Stopping $DESC" "$NAME"
    start-stop-daemon --stop --pidfile $PID_FILE --quiet --retry TERM/30/KILL/5
    RETVAL="$?"
    case "${RETVAL}" in
        # Service was stopped or wasn't running
        0|1) [ "${VERBOSE}" != no ] && log_end_msg 0 ;;
        # Service couldn't be stopped
        2) [ "${VERBOSE}" != no ] && log_end_msg 1 ;;
    esac
    [ "${RETVAL}" = 2 ] && return 2
    [ -f "${PID_FILE}" ] && rm -f ${PID_FILE}
    return 0
}

case "$1" in
    start)
        start_sickshift
        exit $?
        ;;
    stop)
        stop_sickshift
        exit $?
        ;;

    restart|force-reload)
        stop_sickshift
        sleep 2
        start_sickshift
        return $?
        ;;
    status)
        status_of_proc -p "$PID_FILE" "$DAEMON" "$DESC"
        exit 0
        ;;
    *)
        N=/etc/init.d/$NAME
        echo "Usage: $N {start|stop|restart|force-reload}" >&2
        exit 1
        ;;
esac

exit 0
