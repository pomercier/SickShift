#!/bin/sh
#
# PROVIDE: sickshift
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf.local or /etc/rc.conf
# to enable this service:
#
# sickshift_enable: Set YES to enable.
#    Default: NO
# sickshift_user: The user account SickShift daemon runs as.
#    Default: '_sickshift' -- do not set empty or SG will run as root.
# sickshift_dir:	Directory where SickShift lives.
#    Default: /usr/local/sickshift
# sickshift_datadir:  Data directory for SickShift (DB, Logs, config)
#    Default: same as sickshift_dir
# sickshift_pidfile:  The name of the pidfile to create.
#    Default: sickshift.pid in sickshift_dir.
PATH="/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin"

. /etc/rc.subr

name="sickshift"
rcvar=${name}_enable

load_rc_config ${name}

: ${sickshift_enable:="NO"}
: ${sickshift_user:="_sickshift"}
: ${sickshift_dir:="/usr/local/sickshift"}
: ${sickshift_datadir:="${sickshift_dir}"}
: ${sickshift_pidfile:="${sickshift_dir}/sickshift.pid"}

command="${sickshift_dir}/sickshift.py"
command_interpreter="/usr/local/bin/python"
command_args="--daemon --pidfile ${sickshift_pidfile}"

# Add datadir to the command if set
[ ! -z "${sickshift_datadir}" ] && \
  command_args="${command_args} --datadir ${sickshift_datadir}"

run_rc_command "$1"
