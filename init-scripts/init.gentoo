# History
# -------
# 1/29 Created          Richard Powell          richard@powell.ws

# You will need to create a configuration file in order for this script
# to work properly. Please create /etc/conf.d/sickshift with the following:
#
# SICKSHIFT_USER=<user you want sickshift to run under>
# SICKSHIFT_GROUP=<group you want sickshift to run under>
# SICKSHIFT_DIR=<path to sickshift.py>
# PATH_TO_PYTHON=/usr/bin/python
# SICKSHIFT_DATADIR=<directory that contains sickbeard.db file>
# SICKSHIFT_CONFDIR=<directory that contains SickShift's config.ini file>
#

RUNDIR=/var/run/sickshift

depend() {
    need net
}

get_pidfile() {
    # Parse the config.ini file for the value of web_port in the General section
    eval `sed -e 's/[[:space:]]*\=[[:space:]]*/=/g' \
        -e 's/;.*$//' \
        -e 's/[[:space:]]*$//' \
        -e 's/^[[:space:]]*//' \
        -e "s/^\(.*\)=\([^\"']*\)$/\1=\"\2\"/" \
       <  ${SICKSHIFT_CONFDIR}/config.ini \
        | sed -n -e "/^\[General\]/,/^\s*\[/{/^[^;].*\=.*/p;}"`

    echo "${RUNDIR}/sickshift-${web_port}.pid"
}

start() {
    ebegin "Starting SickShift"

    checkpath -q -d -o ${SICKSHIFT_USER}:${SICKSHIFT_GROUP} -m 0770 "${RUNDIR}"

    start-stop-daemon \
        --quiet \
        --start \
        --user ${SICKSHIFT_USER} \
        --group ${SICKSHIFT_GROUP} \
        --name sickshift \
        --background \
        --pidfile $(get_pidfile) \
        --exec ${PATH_TO_PYTHON} \
        -- \
        ${SICKSHIFT_DIR}/sickshift.py \
        -d \
        --pidfile $(get_pidfile) \
        --config ${SICKSHIFT_CONFDIR}/config.ini \
        --datadir ${SICKSHIFT_DATADIR}
    eend $?
}

start_pre() {
    if [ "$RC_CMD" == "restart" ]; then
        local pidfile=$(get_pidfile)
        while [ -e ${pidfile} ]; do
            sleep 1
        done
    fi

    return 0
}

stop() {
    local pidfile=$(get_pidfile)
    local rc

    ebegin "Stopping SickShift"
}
