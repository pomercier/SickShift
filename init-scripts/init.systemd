# SickShift systemd service unit file
#
# Configuration Notes
#
#    - Option names (e.g. ExecStart=, Type=) are case-sensitive)
#
#    - Adjust User= and Group= to the user/group you want SickShift to run as.
#
#    - Optional adjust EnvironmentFile= path to configuration file
#        Can ONLY be used for configuring extra options used in ExecStart.
#        Putting a minus (-) in front of file means no error warning if the file doesn't exist
#
#    - Adjust ExecStart= to point to your python and SickShift executables.
#       The FIRST token of the command line must be an ABSOLUTE FILE NAME, followed by arguments for the process.
#       If no --datadir is given, data is stored in same dir as sickshift.py
#       Arguments can also be set in EnvironmentFile (except python)
#
#    - WantedBy= specifies which target (i.e. runlevel) to start SickShift for.
#        multi-user.target equates to runlevel 3 (multi-user text mode)
#        graphical.target  equates to runlevel 5 (multi-user X11 graphical mode)
#

### Example Using simple
# Type=simple
# ExecStart=/usr/bin/python /opt/sickshift/app/sickshift.py -q --nolaunch

### Example Using simple with EnvironmentFile where SB_DATA=/home/sickshift/.sickshift in /etc/sickshift.conf
# Type=simple
# EnvironmentFile=/etc/sickshift.conf
# ExecStart=/usr/bin/python /opt/sickshift/app/sickshift.py -q --nolaunch --datadir=${SB_DATA}

### Configuration

[Unit]
Description=SickShift Service

[Service]
User=sickshift
Group=sickshift

Environment=PYTHONUNBUFFERED=true
ExecStart=/opt/sickshift/app/sickshift.py --systemd --datadir=/opt/sickshift/data
KillMode=process
Restart=on-failure
ProtectSystem=full
DeviceAllow=/dev/null rw
DeviceAllow=/dev/urandom r
DevicePolicy=strict
NoNewPrivileges=yes
WorkingDirectory=/opt/sickshift

[Install]
WantedBy=multi-user.target
