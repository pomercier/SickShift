			transform: scale(1.08);
		}

		/* Small Poster mode (thumbnails) */
		.imgsmallposter {
			position: relative;
		}
		.imgsmallposter img.small {
			transition: transform 250ms cubic-bezier(.4, 0, .2, 1), box-shadow 250ms cubic-bezier(.4, 0, .2, 1), border-color 250ms cubic-bezier(.4, 0, .2, 1);
