		.imgbanner {
			overflow: hidden;
			border-radius: 8px;
		}
		.imgbanner .banner {
			transition: transform 300ms cubic-bezier(.4, 0, .2, 1), box-shadow 300ms cubic-bezier(.4, 0, .2, 1);
