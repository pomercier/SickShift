			<div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
				<ul class="nav navbar-nav navbar-right">
					<li id="NAVsoundtrack">
						<button type="button" id="btn-global-soundtrack" class="soundtrack-nav-btn" title="Thème musical : Activé par défaut (cliquer pour couper)">
							<span class="st-speaker-icon">🔊</span>
							<span class="st-speaker-label">Musique</span>
						</button>
					</li>
					<audio id="global-sg-soundtrack" preload="none" style="display:none"></audio>
					<script>
					(function(){
						var STORAGE_KEY = 'sg_soundtrack_enabled';
						var state = localStorage.getItem(STORAGE_KEY);
						if (state === null) {
							state = 'on';
							localStorage.setItem(STORAGE_KEY, 'on');
						}
						window.sgSoundtrackState = state;

						function updateBtn(){
							var btn = document.getElementById('btn-global-soundtrack');
							if (!btn) return;
							var icon = btn.querySelector('.st-speaker-icon');
							var label = btn.querySelector('.st-speaker-label');
							if (window.sgSoundtrackState === 'on') {
								btn.classList.remove('muted');
								btn.classList.add('playing');
								if (icon) {
									icon.textContent = '🔊';
									icon.classList.add('st-wave');
								}
								if (label) label.textContent = 'Musique';
								btn.title = 'Thème musical : Activé (cliquer pour couper la musique)';
							} else {
								btn.classList.add('muted');
								btn.classList.remove('playing');
								if (icon) {
									icon.textContent = '🔇';
									icon.classList.remove('st-wave');
								}
								if (label) label.textContent = 'Musique off';
								btn.title = 'Thème musical : Désactivé (cliquer pour activer)';
							}
						}

						window.toggleGlobalSoundtrack = function(){
							var current = localStorage.getItem(STORAGE_KEY) || 'on';
							var next = (current === 'on') ? 'off' : 'on';
							localStorage.setItem(STORAGE_KEY, next);
							window.sgSoundtrackState = next;
							updateBtn();
							var audio = document.getElementById('global-sg-soundtrack');
							if (next === 'off') {
								if (audio) { audio.pause(); }
							} else {
								if (window.sgCurrentShowSoundtrackUrl && audio) {
									audio.src = window.sgCurrentShowSoundtrackUrl;
									audio.volume = 0.35;
									audio.loop = true;
									audio.play().catch(function(){});
								}
							}
						};

						var soundtrackFadeTimer = null;
						window.fadeGlobalSoundtrackOut = function(duration){
							duration = duration || 450;
							var audio = document.getElementById('global-sg-soundtrack');
							if (!audio || audio.paused || audio.volume <= 0) return;
							clearInterval(soundtrackFadeTimer);
							var startVol = audio.volume;
							var stepTime = 25;
							var steps = Math.max(1, Math.floor(duration / stepTime));
							var volStep = startVol / steps;
							var step = 0;
							window.sgSoundtrackFadingOut = true;
							soundtrackFadeTimer = setInterval(function(){
								step++;
								var v = Math.max(0, startVol - (volStep * step));
								audio.volume = v;
								if (v <= 0.005 || step >= steps) {
									clearInterval(soundtrackFadeTimer);
									audio.volume = 0;
									audio.pause();
									window.sgSoundtrackFadingOut = false;
									window.sgSoundtrackPausedByPopup = true;
								}
							}, stepTime);
						};

						window.fadeGlobalSoundtrackIn = function(targetVol, duration){
							targetVol = (typeof targetVol !== 'undefined') ? targetVol : 0.35;
							duration = duration || 600;
							if (window.sgSoundtrackState === 'off') return;
							var audio = document.getElementById('global-sg-soundtrack');
							if (!audio) return;
							if (!audio.src && window.sgCurrentShowSoundtrackUrl) {
								audio.src = window.sgCurrentShowSoundtrackUrl;
							}
							if (!audio.src) return;
							clearInterval(soundtrackFadeTimer);
							window.sgSoundtrackFadingOut = false;
							var startVol = audio.volume;
							if (audio.paused) {
								audio.volume = 0;
								startVol = 0;
								audio.loop = true;
								var p = audio.play();
								if (p !== undefined) p.catch(function(){});
							}
							var stepTime = 25;
							var steps = Math.max(1, Math.floor(duration / stepTime));
							var volDiff = targetVol - startVol;
							var volStep = volDiff / steps;
							var step = 0;
							soundtrackFadeTimer = setInterval(function(){
								step++;
								var v = Math.min(targetVol, Math.max(0, startVol + (volStep * step)));
								audio.volume = v;
								if (v >= targetVol - 0.005 || step >= steps) {
									clearInterval(soundtrackFadeTimer);
									audio.volume = targetVol;
									window.sgSoundtrackPausedByPopup = false;
								}
							}, stepTime);
						};

						window.playShowSoundtrack = function(showId, showName, indexer){
							if (!showId) return;
							indexer = indexer || 1;
							var navItem = document.getElementById('NAVsoundtrack');
							if (navItem) {
								navItem.style.setProperty('display', 'flex', 'important');
							}
							var audio = document.getElementById('global-sg-soundtrack');
							if (!audio) return;
							var root = (typeof window.sbRoot !== 'undefined' ? window.sbRoot : '') || '';
							var primaryUrl = root + '/dashboard/media/soundtrack/' + indexer + '/' + showId;
							var fallbackUrl = 'https://tvthemes.plexapp.com/' + showId + '.mp3';

							window.sgCurrentShowSoundtrackUrl = primaryUrl;
							updateBtn();

							if (window.sgSoundtrackState !== 'on') {
								return;
							}

							audio.loop = true;
							audio.src = primaryUrl;
							audio.volume = 0.35;

							audio.onerror = function() {
								if (audio.src !== fallbackUrl && indexer == 1) {
									audio.src = fallbackUrl;
									audio.play().catch(function(){});
								}
							};

							var p = audio.play();
							if (p !== undefined) {
								p.catch(function(err){
									function onFirstInteraction(){
										document.removeEventListener('click', onFirstInteraction);
										if (window.sgSoundtrackState === 'on' && audio.paused) {
											audio.play().catch(function(){});
										}
									}
									document.addEventListener('click', onFirstInteraction, { once: true });
								});
							}
						};

						document.addEventListener('DOMContentLoaded', function(){
							updateBtn();
							var btn = document.getElementById('btn-global-soundtrack');
							if (btn) {
								btn.addEventListener('click', function(e){
									e.preventDefault();
									e.stopPropagation();
									window.toggleGlobalSoundtrack();
								});
							}
						});
					})();
					</script>
